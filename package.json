  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/react": "19.3.0",
    "shadcn": "4.22.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
